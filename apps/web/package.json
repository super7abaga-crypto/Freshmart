{
  "name": "freshmart-web",
  "private": true,
  "version": "1.0.0",
  "description": "Freshmart storefront. TypeScript for the small client-side parts; pages are rendered by the API (Jinja + HTMX).",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --minify --target=es2020 --outfile=static/js/main.js",
    "typecheck": "tsc --noEmit",
    "watch": "esbuild src/main.ts --bundle --target=es2020 --outfile=static/js/main.js --watch"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "typescript": "5.6.3"
  }
}
