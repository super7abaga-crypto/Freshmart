# Copy to .env for local development (optional: the app runs without one,
# using the JSON file database and a random per-run JWT secret).

# Unset = local JSON file at apps/api/data/db.json.
# Set = Postgres (Render provides this automatically).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Protects GET /api/store/notifications (customer addresses + phones).
# Send as the X-Staff-Key header. In production the feed is disabled if unset.
# STORE_STAFF_KEY=

# Set to "production" anywhere that is not Render (Render is detected automatically).
# ENV=production
# PORT=4000

# Store SMS. Unset = demo mode: the new-order text is stored for the staff feed only.
# To text the shop for real, set all four (Termii shown; africastalking also works,
# with AFRICASTALKING_USERNAME added):
# SMS_PROVIDER=termii
# SMS_API_KEY=
# SMS_SENDER_ID=OGS
# STORE_PHONE=+2348031234567
# AFRICASTALKING_USERNAME=sandbox
