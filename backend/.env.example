# Copy this file to .env for local development (optional — the app runs
# fine without one, using the flat JSON file database and a dev JWT secret).
#
# In production (e.g. on Render), set these as real environment variables
# instead of committing a .env file — see README.md.

# Leave unset locally to use the flat-file database at backend/data/db.json.
# Set this to a real Postgres connection string to use Postgres instead —
# Render provides one automatically when you attach its managed database.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Used to sign session cookies. Any long random string works; generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-secret-change-me-before-real-use

# Optional — defaults to 4000.
# PORT=4000
